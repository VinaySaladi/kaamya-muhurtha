# --- AI (Anthropic Claude API) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
KAAMYA_MODEL=claude-sonnet-5-5          # or claude-haiku-5-5 (much cheaper; test Telugu/Marathi quality)
KAAMYA_MAX_TOKENS=1500

# --- Keys the Kaamya backend / admin console use to call this service ---
# Generate long random strings, e.g.  python -c "import secrets;print(secrets.token_urlsafe(32))"
KAAMYA_API_KEY=change-me-app-backend-key
KAAMYA_ADMIN_KEY=change-me-admin-console-key

# --- Behaviour ------------------------------------------------------------
KAAMYA_AUTO_APPROVE=false               # beta: false = senior pandit approves every muhurtham
KAAMYA_REVIEW_PROMISE_HOURS=24          # what the Acharya promises the family
KAAMYA_ASSISTANT_NAME=Kaamya Acharya
KAAMYA_DEFAULT_CITY=Hyderabad
KAAMYA_MAX_WINDOW_DAYS=366
KAAMYA_ENABLE_DEMO=false                # true = serve the test chat screen at /demo

# --- Privacy / retention ---------------------------------------------------
KAAMYA_SESSION_TTL_HOURS=48             # abandoned chats (with birth details) are deleted after this
KAAMYA_RESULT_TTL_DAYS=30               # delivered results (no birth details) kept this long

# --- Storage & notifications ------------------------------------------------
KAAMYA_DB_PATH=/data/kaamya_muhurtha.db
KAAMYA_WEBHOOK_URL=                     # your backend endpoint to receive status changes
KAAMYA_WEBHOOK_SECRET=                  # HMAC-SHA256 signature in X-Kaamya-Signature

# --- Optional online geocoding for small towns (OpenStreetMap Nominatim) ----
KAAMYA_GEOCODER=off                     # off | nominatim
KAAMYA_GEOCODER_UA=kaamya-muhurtha/1.0 (support@thevaidikgroup.com)
